# Django Settings
DJANGO_SECRET_KEY=change-me-in-production-use-docker-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.yobhou.gn,localhost,127.0.0.1

# Database
POSTGRES_USER=yobhou_user
POSTGRES_PASSWORD=change-me-use-docker-secret
POSTGRES_DB=yobhou_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# ELK Stack
ELASTIC_PASSWORD=change-me-use-docker-secret
ELASTICSEARCH_HOST=elasticsearch

# AWS S3 (Archive 10 ans)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-central-1
ARCHIVE_S3_BUCKET=yobhou-audit-logs

# Encryption Key (Fernet)
ENCRYPTION_KEY=change-me-use-docker-secret-fernet-key

# Grafana
GRAFANA_PASSWORD=change-me-use-docker-secret

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
